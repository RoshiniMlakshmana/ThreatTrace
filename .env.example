# ThreatTrace environment configuration (Block 15L-16).
#
# Copy this file to `.env` and fill in real values ONLY for the variables
# you actually intend to use. `.env` is git-ignored — never commit it.
# This file must never contain a real API key, token, or credential —
# every value below is a placeholder only.
#
# ThreatTrace does not currently auto-load `.env` at runtime; these
# variables must be set in your shell/session environment (e.g. via
# your OS, a process manager, or `python-dotenv` if you add it
# yourself). None of the variables below are required for the core
# Bug Bounty / Detection Engineering / live platform workflows to run
# — every one of them enables an OPTIONAL, already-unconfigured-by-default
# capability.

# -----------------------------------------------------------------------
# Burp Suite DAST -- optional, external, analyst-configured runtime.
# Without these, adapters.bug_bounty_burp and runtime.tool_runtime both
# honestly report burp_dast as "not_configured" -- ThreatTrace never
# bundles or auto-installs Burp.
# -----------------------------------------------------------------------
THREATTRACE_BURP_API_KEY=your-burp-rest-api-key-here
THREATTRACE_BURP_API_HOST=127.0.0.1
THREATTRACE_BURP_API_PORT=1337

# -----------------------------------------------------------------------
# Threat Intelligence -- optional, credential-required sources. Without
# these, adapters.threat_intel_configured_sources honestly reports each
# as runtime_status "not_configured" and attempts no network call.
# CISA KEV / NVD / EPSS require no credentials and are not listed here.
# -----------------------------------------------------------------------
THREATTRACE_TAXII_API_KEY=your-taxii-api-key-here
THREATTRACE_MISP_API_KEY=your-misp-api-key-here
THREATTRACE_OPENCTI_API_KEY=your-opencti-api-key-here

# Public/community Telegram OSINT -- treated as untrusted public OSINT,
# never as an authoritative or "dark web" source. See
# adapters.threat_intel_configured_sources for the exact trust framing.
THREATTRACE_TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# -----------------------------------------------------------------------
# Nuclei templates -- optional override of the default template
# directory runtime.tool_runtime.check_nuclei_templates looks for
# (~/nuclei-templates when unset).
# -----------------------------------------------------------------------
THREATTRACE_NUCLEI_TEMPLATES_DIR=/path/to/nuclei-templates

# -----------------------------------------------------------------------
# Live platform backend (backend/app.py) -- NOT currently configurable
# via environment variable. The bind is hardcoded to 127.0.0.1:8420 in
# backend/app.py (BIND_HOST/BIND_PORT) precisely so it can never be
# accidentally exposed via a misconfigured environment. If a future
# block adds env-based override support, the default MUST remain
# 127.0.0.1 -- never 0.0.0.0 or a LAN-reachable address.
# -----------------------------------------------------------------------
